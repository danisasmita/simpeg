# Server
APP_PORT=8080
APP_URL=http://localhost:8000
# Lokasi build SPA statis (biasanya frontend/dist). Kosong tidak masalah — default dipakai.
WEB_ROOT=frontend/dist

# Database
# Inside Docker: DB_HOST=db DB_PORT=5432. Docker host port: 5433.
DB_HOST=localhost
DB_PORT=5433
DB_USER=simpeg
DB_PASSWORD=secret
DB_NAME=simpeg
DB_SSLMODE=disable

# Redis
# Inside Docker: REDIS_HOST=redis REDIS_PORT=6379. Docker host port: 6380.
REDIS_HOST=localhost
REDIS_PORT=6380

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=120m

# Google OAuth (SSO) — opsional; kosongkan untuk menonaktifkan "Masuk dengan Google"
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URL=http://localhost:8000/api/v1/auth/google/callback

# SMTP (opsional). Isi untuk mengirim email asli (reset password & verifikasi).
# Tanpa SMTP, token dikembalikan langsung di respons (mode pengembangan).
# Dev MailHog: SMTP_HOST=mailhog, SMTP_PORT=1025, UI http://localhost:8025
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=noreply@uml.ac.id
# SMTP_FROM_NAME="SIMPEG UML"

# Sentry (error & performance tracking). SENTRY_DSN kosong = nonaktif.
SENTRY_DSN=
SENTRY_ENV=local
SENTRY_TRACES_SAMPLE_RATE=0.1
# Origin ekstra utk CORS (mis. http://localhost:5173 saat buka Vite langsung)
APP_ALLOWED_ORIGINS=
